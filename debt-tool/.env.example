# ─────────────────────────────────────────────────────────────────────────────
# Mlinjana Financial Group — Client Debt Tool
# Copy to .env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Signs session cookies and derives the key that encrypts ID numbers at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes every already-encrypted ID number unreadable — set it once,
# back it up somewhere safe, and treat it like the keys to the filing cabinet.
APP_SECRET=

DATABASE_FILE=./data/mfg-debt-tool.db
SESSION_TTL_HOURS=8

# Must be true in production so session cookies are only sent over HTTPS.
COOKIE_SECURE=false

# How many days before the tool flags a credit profile as out of date.
SNAPSHOT_STALE_DAYS=30

MAX_UPLOAD_BYTES=15728640

# ── Credit bureaus ───────────────────────────────────────────────────────────
# Which bureau is pre-selected on the enquiry form.
BUREAU_DEFAULT=mock

# The simulated bureau produces realistic but entirely fictional profiles, for
# development and for training consultants. Set to false in production so
# fictional figures can never reach a client.
BUREAU_ALLOW_MOCK=true

BUREAU_TIMEOUT_MS=20000

# TransUnion Africa — OAuth2 client credentials.
TRANSUNION_BASE_URL=
TRANSUNION_CLIENT_ID=
TRANSUNION_CLIENT_SECRET=
TRANSUNION_SUBSCRIBER_CODE=
TRANSUNION_INDUSTRY_CODE=DC

# Experian South Africa — per-request subscriber credentials.
EXPERIAN_BASE_URL=
EXPERIAN_USERNAME=
EXPERIAN_PASSWORD=
EXPERIAN_SUBSCRIBER_CODE=

# XDS (Xpert Decision Systems).
XDS_BASE_URL=
XDS_USERNAME=
XDS_PASSWORD=
XDS_PRODUCT_CODE=ConsumerCreditReport

# ── First administrator (used by `npm run seed`) ─────────────────────────────
SEED_ADMIN_EMAIL=admin@mlinjana.co.za
SEED_ADMIN_NAME=MFG Administrator
# Leave blank to have one generated and printed once.
SEED_ADMIN_PASSWORD=
