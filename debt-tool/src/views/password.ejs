<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Change your password</h1>
    <p class="sub">Signed in as <%= currentUser.email %></p>
  </div>
</div>

<div class="card" style="max-width:520px;">
  <div class="card-body">
    <% if (done) { %>
      <div class="notice notice-ok">Your password has been changed.</div>
      <a href="/clients" class="btn btn-ghost">Back to clients</a>
    <% } else { %>
      <% if (error) { %><div class="notice notice-error"><%= error %></div><% } %>

      <form method="post" action="/account/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="field">
          <label for="currentPassword">Current password</label>
          <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password" />
        </div>

        <div class="field">
          <label for="newPassword">New password</label>
          <input type="password" id="newPassword" name="newPassword" required minlength="12" autocomplete="new-password" />
          <p class="hint">At least 12 characters. A passphrase of three or four unrelated words works well.</p>
        </div>

        <div class="field">
          <label for="confirmPassword">Confirm new password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" required minlength="12" autocomplete="new-password" />
        </div>

        <button type="submit" class="btn btn-gold">Change password</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
