<%
  const c = view.client;
  const d = view.debt;
  const aff = view.affordability;
  const r = view.restructure;
  const canEdit = currentUser.role !== 'readonly';
  const riskCopy = {
    critical: 'Critical — repayments exceed what this client can afford',
    elevated: 'Elevated — the client is under strain',
    moderate: 'Moderate — manageable but worth watching',
    stable: 'Stable — repayments are within reach',
  };
  const flashCopy = {
    'pull-complete': 'Credit bureau enquiry completed. The figures below are from the new pull.',
    'import-complete': 'Bureau report imported. The figures below reflect the accounts you confirmed.',
    'financials-saved': 'Income and expenses saved. The affordability assessment has been recalculated.',
    'consent-recorded': 'Consent recorded.',
    'consent-revoked': 'Consent revoked. No further bureau enquiries can be run for this client.',
  };
  const segColours = ['#0a1628', '#c9a84c', '#1a3a6b', '#a07830', '#4a6fa5', '#e8c96a', '#8a8a8a'];
%>
<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <h1><%= c.first_name %> <%= c.last_name %></h1>
    <p class="sub">
      <span class="mono"><%= c.reference %></span> ·
      ID •••• <%= c.id_number_last4 %> ·
      <%= c.phone || 'no phone on file' %>
      <% if (c.dependants > 0) { %> · <%= c.dependants %> dependant<%= c.dependants === 1 ? '' : 's' %><% } %>
    </p>
  </div>
  <div class="spacer"></div>
  <div class="btn-row">
    <% if (canEdit) { %>
      <a href="/clients/<%= c.id %>/edit" class="btn btn-ghost btn-sm">Edit details</a>
      <a href="/clients/<%= c.id %>/import" class="btn btn-ghost btn-sm">Import PDF report</a>
    <% } %>
  </div>
</div>

<% if (flash && flashCopy[flash]) { %>
  <div class="notice notice-ok"><%= flashCopy[flash] %></div>
<% } %>

<% if (typeof pullError !== 'undefined' && pullError) { %>
  <div class="notice notice-error">
    <strong>The bureau enquiry did not complete.</strong><br />
    <%= pullError %>
  </div>
<% } %>

<% if (view.snapshot && view.snapshot.is_simulated) { %>
  <div class="notice notice-warn">
    <strong>Simulated data.</strong> This profile came from the built-in test bureau, not a real credit bureau.
    The figures are fictional and must not be shown to the client or used in a debt review application.
  </div>
<% } %>

<% if (!view.hasBureauConsent) { %>
  <div class="notice notice-warn">
    <strong>No active bureau consent on file.</strong>
    A credit bureau enquiry cannot be run until the client's consent is captured below.
  </div>
<% } %>

<% if (view.hasSnapshot && view.snapshotIsStale) { %>
  <div class="notice notice-info">
    This profile was pulled on <%= formatDate(view.snapshot.requested_at, { withTime: true }) %> and may be out of date.
    Consider refreshing before advising the client.
  </div>
<% } %>

<% if (!view.hasSnapshot) { %>
  <!-- ── Nothing pulled yet ─────────────────────────────────────────── -->
  <div class="card">
    <div class="empty">
      <h3>No credit profile yet</h3>
      <p>Run a bureau enquiry or import the client's own bureau report to see what they owe.</p>
    </div>
  </div>
<% } else { %>

  <!-- ── Headline figures ─────────────────────────────────────────────── -->
  <div class="grid grid-4" style="margin-bottom:1.25rem;">
    <div class="stat feature">
      <div class="stat-label">Total owed</div>
      <div class="stat-value"><%= money(d.totalOwedCents) %></div>
      <div class="stat-note"><%= d.accountCount %> active account<%= d.accountCount === 1 ? '' : 's' %></div>
    </div>

    <div class="stat">
      <div class="stat-label">Monthly repayments</div>
      <div class="stat-value"><%= money(d.totalInstalmentCents) %></div>
      <div class="stat-note">
        <% if (aff.hasIncomeData && aff.instalmentToIncome !== null) { %>
          <%= percent(aff.instalmentToIncome) %> of net income
        <% } else { %>
          Capture income to see this as a share
        <% } %>
      </div>
    </div>

    <div class="stat">
      <div class="stat-label">In arrears</div>
      <div class="stat-value <%= d.totalArrearsCents > 0 ? 'danger' : 'success' %>"><%= money(d.totalArrearsCents) %></div>
      <div class="stat-note">
        <% if (d.accountsInArrearsCount > 0) { %>
          <%= d.accountsInArrearsCount %> account<%= d.accountsInArrearsCount === 1 ? '' : 's' %>,
          worst <%= d.worstArrearsMonths %> month<%= d.worstArrearsMonths === 1 ? '' : 's' %> behind
        <% } else { %>
          All accounts up to date
        <% } %>
      </div>
    </div>

    <div class="stat">
      <div class="stat-label">Credit score</div>
      <div class="stat-value"><%= view.snapshot.credit_score || '—' %></div>
      <div class="stat-note"><%= view.snapshot.score_band || 'Not supplied by this source' %></div>
    </div>
  </div>

  <!-- ── Risk verdict ─────────────────────────────────────────────────── -->
  <div class="risk-strip risk-<%= aff.riskLevel %>" style="margin-bottom:1.25rem;">
    <span><%= riskCopy[aff.riskLevel] %></span>
    <% if (aff.overIndebted) { %>
      <span class="badge danger" style="margin-left:auto;">Indicators of over-indebtedness</span>
    <% } %>
  </div>

  <% if (aff.overIndebted && aff.overIndebtedReasons.length) { %>
    <div class="notice notice-warn">
      <strong>Why this client shows as over-indebted:</strong>
      <ul>
        <% aff.overIndebtedReasons.forEach((reason) => { %><li><%= reason %></li><% }) %>
      </ul>
      <p class="small" style="margin-top:0.6rem;">
        These are indicators, not a determination. A declaration of over-indebtedness under
        section 79 of the National Credit Act remains the debt counsellor's assessment.
      </p>
    </div>
  <% } %>

  <div class="grid grid-2">
    <!-- ── Who they owe ───────────────────────────────────────────────── -->
    <div class="card section-anchor" id="creditors">
      <div class="card-head">
        <h2>Who they owe</h2>
        <span class="spacer"></span>
        <span class="badge"><%= d.byCreditor.length %> creditor<%= d.byCreditor.length === 1 ? '' : 's' %></span>
      </div>
      <div class="card-body tight">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Creditor</th>
                <th class="num">Balance</th>
                <th class="num">Monthly</th>
                <th class="num">Arrears</th>
              </tr>
            </thead>
            <tbody>
              <% d.byCreditor.forEach((row) => { %>
                <tr>
                  <td>
                    <strong><%= row.creditorName %></strong>
                    <% if (row.accountCount > 1) { %>
                      <span class="badge"><%= row.accountCount %> accounts</span>
                    <% } %>
                    <% if (row.worstArrearsMonths > 0) { %>
                      <br /><span class="badge danger"><%= row.worstArrearsMonths %> months behind</span>
                    <% } %>
                  </td>
                  <td class="num"><strong><%= money(row.balanceCents) %></strong></td>
                  <td class="num"><%= money(row.instalmentCents) %></td>
                  <td class="num <%= row.arrearsCents > 0 ? '' : 'muted' %>">
                    <%= row.arrearsCents > 0 ? money(row.arrearsCents) : '—' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr>
                <td>Total</td>
                <td class="num"><%= money(d.totalOwedCents) %></td>
                <td class="num"><%= money(d.totalInstalmentCents) %></td>
                <td class="num"><%= money(d.totalArrearsCents) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- ── What kind of debt ──────────────────────────────────────────── -->
    <div class="card">
      <div class="card-head"><h2>What kind of debt</h2></div>
      <div class="card-body">
        <% if (d.totalOwedCents > 0) { %>
          <div class="bar">
            <% d.byType.forEach((row, i) => {
                 const pct = (row.balanceCents / d.totalOwedCents) * 100; %>
              <div class="bar-seg"
                   style="width:<%= pct.toFixed(2) %>%;background:<%= segColours[i % segColours.length] %>"
                   title="<%= row.label %>"></div>
            <% }) %>
          </div>
          <div class="bar-legend">
            <% d.byType.forEach((row, i) => { %>
              <div class="bar-legend-row">
                <span class="swatch" style="background:<%= segColours[i % segColours.length] %>"></span>
                <span><%= row.label %></span>
                <span class="muted small">(<%= row.accountCount %>)</span>
                <span class="amount"><%= money(row.balanceCents, { compact: true }) %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="muted">No outstanding balances on this profile.</p>
        <% } %>

        <hr style="border:none;border-top:1px solid var(--grey-line);margin:1.1rem 0;" />

        <dl class="dl">
          <dt>Secured vs unsecured</dt>
          <dd>
            <% const secured = d.byCategory.find((x) => x.category === 'secured'); %>
            <%= secured ? money(secured.balanceCents, { compact: true }) : 'R0' %> secured
            · <%= money(d.totalOwedCents - (secured ? secured.balanceCents : 0), { compact: true }) %> other
          </dd>
          <dt>Average interest rate</dt>
          <dd><%= d.averageInterestRate ? percent(d.averageInterestRate) : '—' %></dd>
          <% if (d.largestAccount) { %>
            <dt>Largest single debt</dt>
            <dd><%= d.largestAccount.creditor_name %> — <%= money(d.largestAccount.current_balance_cents, { compact: true }) %></dd>
          <% } %>
          <% if (d.writtenOffCents > 0) { %>
            <dt>Written off</dt>
            <dd>
              <%= money(d.writtenOffCents, { compact: true }) %>
              <span class="muted small">(still legally owed)</span>
            </dd>
          <% } %>
        </dl>
      </div>
    </div>
  </div>

  <!-- ── Every account ────────────────────────────────────────────────── -->
  <div class="card section-anchor" id="accounts">
    <div class="card-head">
      <h2>Every account on the profile</h2>
      <span class="spacer"></span>
      <span class="muted small">
        Source: <%= view.snapshot.provider %> ·
        <%= formatDate(view.snapshot.requested_at, { withTime: true }) %>
      </span>
    </div>
    <div class="card-body tight">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Creditor</th>
              <th>Type</th>
              <th>Account</th>
              <th>Opened</th>
              <th class="num">Balance</th>
              <th class="num">Instalment</th>
              <th class="num">Arrears</th>
              <th class="num">Rate</th>
              <th>Status</th>
              <% if (canEdit) { %><th></th><% } %>
            </tr>
          </thead>
          <tbody>
            <% view.accounts.forEach((a) => { %>
              <tr class="<%= a.is_excluded ? 'row-excluded' : '' %>">
                <td>
                  <strong><%= a.creditor_name %></strong>
                  <% if (a.is_excluded && a.exclusion_reason) { %>
                    <br /><span class="muted small">Excluded: <%= a.exclusion_reason %></span>
                  <% } %>
                </td>
                <td class="small"><%= accountTypes[a.account_type] ? accountTypes[a.account_type].label : 'Other' %></td>
                <td class="mono small muted"><%= a.account_number_masked || '—' %></td>
                <td class="small"><%= formatDate(a.opened_date) %></td>
                <td class="num"><strong><%= money(a.current_balance_cents) %></strong></td>
                <td class="num"><%= money(a.monthly_instalment_cents) %></td>
                <td class="num">
                  <% if (a.arrears_amount_cents > 0) { %>
                    <span style="color:var(--danger)"><%= money(a.arrears_amount_cents) %></span>
                    <% if (a.months_in_arrears > 0) { %>
                      <br /><span class="muted small"><%= a.months_in_arrears %> mo</span>
                    <% } %>
                  <% } else { %><span class="muted">—</span><% } %>
                </td>
                <td class="num small"><%= a.interest_rate_annual ? percent(a.interest_rate_annual) : '—' %></td>
                <td>
                  <span class="badge <%= a.status === 'written_off' || a.status === 'legal' ? 'danger' : a.status === 'closed' ? '' : 'success' %>">
                    <%= a.status.replace(/_/g, ' ') %>
                  </span>
                </td>
                <% if (canEdit) { %>
                  <td>
                    <form method="post" action="/clients/<%= c.id %>/accounts/<%= a.id %>/exclude">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="excluded" value="<%= a.is_excluded ? '0' : '1' %>" />
                      <% if (!a.is_excluded) { %>
                        <input type="hidden" name="reason" value="Excluded by consultant" />
                      <% } %>
                      <button type="submit" class="btn btn-sm btn-ghost">
                        <%= a.is_excluded ? 'Include' : 'Exclude' %>
                      </button>
                    </form>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (d.excludedCount > 0) { %>
        <p class="footnote" style="padding:0 1.25rem 1rem;">
          <%= d.excludedCount %> account<%= d.excludedCount === 1 ? ' is' : 's are' %> excluded from the totals and
          the restructure proposal above. Excluded accounts stay on the file so the full picture is never lost.
        </p>
      <% } %>
    </div>
  </div>
<% } %>

<div class="grid grid-2">
  <!-- ── Affordability ──────────────────────────────────────────────── -->
  <div class="card section-anchor" id="affordability">
    <div class="card-head">
      <h2>Affordability</h2>
      <span class="spacer"></span>
      <% if (view.profile) { %>
        <span class="muted small">Captured <%= formatDate(view.profile.effective_from, { withTime: true }) %></span>
      <% } %>
    </div>
    <div class="card-body">
      <% if (aff.hasIncomeData) { %>
        <dl class="dl" style="margin-bottom:1.1rem;">
          <dt>Net monthly income</dt><dd><%= money(aff.netIncomeCents) %></dd>
          <dt>Living expenses</dt><dd><%= money(aff.declaredExpensesCents) %></dd>
          <dt>Available for debt</dt>
          <dd style="color:<%= aff.availableForDebtCents > 0 ? 'var(--success)' : 'var(--danger)' %>">
            <%= money(aff.availableForDebtCents) %>
          </dd>
          <dt>Current repayments</dt><dd><%= money(aff.totalInstalmentCents) %></dd>
          <dt>Surplus / shortfall</dt>
          <dd style="color:<%= aff.surplusCents >= 0 ? 'var(--success)' : 'var(--danger)' %>">
            <%= money(aff.surplusCents) %>
          </dd>
          <dt>Debt-to-income</dt>
          <dd><%= aff.debtToIncome !== null ? percent(aff.debtToIncome, 0) + ' of annual income' : '—' %></dd>
        </dl>

        <% if (aff.expensesBelowGuideline) { %>
          <div class="notice notice-warn small">
            The declared expenses (<%= money(aff.declaredExpensesCents, { compact: true }) %>) fall below the
            guideline minimum for this income level (<%= money(aff.minimumExpensesCents, { compact: true }) %>).
            Clients commonly under-report — check the figures before relying on the surplus.
          </div>
        <% } %>
      <% } else { %>
        <p class="muted" style="margin-bottom:1rem;">
          No income captured yet. Without it the tool can show what the client owes,
          but not whether they can afford it.
        </p>
      <% } %>

      <% if (canEdit) { %>
        <details <%= aff.hasIncomeData ? '' : 'open' %>>
          <summary style="cursor:pointer;font-weight:600;color:var(--navy);margin-bottom:0.8rem;">
            <%= aff.hasIncomeData ? 'Update income & expenses' : 'Capture income & expenses' %>
          </summary>

          <form method="post" action="/clients/<%= c.id %>/financials" style="margin-top:0.9rem;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <div class="field-row">
              <div class="field">
                <label for="grossIncome">Gross monthly income</label>
                <input type="text" id="grossIncome" name="grossIncome" inputmode="decimal"
                       value="<%= view.profile ? (view.profile.gross_monthly_income_cents / 100).toFixed(2) : '' %>" />
              </div>
              <div class="field">
                <label for="netIncome">Net (take-home) monthly income</label>
                <input type="text" id="netIncome" name="netIncome" inputmode="decimal" required
                       value="<%= view.profile ? (view.profile.net_monthly_income_cents / 100).toFixed(2) : '' %>" />
              </div>
              <div class="field">
                <label for="otherIncome">Other income</label>
                <input type="text" id="otherIncome" name="otherIncome" inputmode="decimal"
                       value="<%= view.profile ? (view.profile.other_income_cents / 100).toFixed(2) : '' %>" />
              </div>
            </div>

            <h3 style="font-size:0.9rem;margin:1rem 0 0.6rem;">Monthly living expenses</h3>
            <div class="field-row">
              <% Object.entries(expenseCategories).forEach(([key, label]) => { %>
                <div class="field">
                  <label for="expense_<%= key %>"><%= label %></label>
                  <input type="text" id="expense_<%= key %>" name="expense_<%= key %>" inputmode="decimal"
                         value="<%= aff.expenses[key] ? (aff.expenses[key] / 100).toFixed(2) : '' %>" />
                </div>
              <% }) %>
            </div>

            <button type="submit" class="btn btn-gold">Save assessment</button>
          </form>
        </details>
      <% } %>
    </div>
  </div>

  <!-- ── Pull a fresh profile ───────────────────────────────────────── -->
  <div class="card section-anchor" id="pull">
    <div class="card-head"><h2>Pull a credit profile</h2></div>
    <div class="card-body">
      <% if (!view.hasBureauConsent) { %>
        <div class="notice notice-warn">
          Capture the client's consent below before running an enquiry.
        </div>
      <% } %>

      <% if (providers.length === 0) { %>
        <p class="muted">No bureau is configured on this instance. See Settings for what is missing.</p>
      <% } else if (canEdit) { %>
        <form method="post" action="/clients/<%= c.id %>/pull">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="field">
            <label for="provider">Credit bureau</label>
            <select id="provider" name="provider">
              <% providers.forEach((p) => { %>
                <option value="<%= p.id %>" <%= p.id === defaultProvider ? 'selected' : '' %>>
                  <%= p.label %><%= p.isSimulated ? ' — simulated' : '' %>
                </option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-gold" <%= view.hasBureauConsent ? '' : 'disabled' %>>
            Run enquiry
          </button>
          <p class="footnote">
            Every enquiry is billed by the bureau, recorded against your name, and appears on the
            client's own credit record as a search. Only run one when you need current figures.
          </p>
        </form>
      <% } else { %>
        <p class="muted">Your account has read-only access.</p>
      <% } %>

      <% if (view.snapshots.length > 0) { %>
        <hr style="border:none;border-top:1px solid var(--grey-line);margin:1.2rem 0;" />
        <h3 style="font-size:0.9rem;margin-bottom:0.6rem;">Previous pulls</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Date</th><th>Source</th><th class="num">Owed</th><th>By</th></tr>
            </thead>
            <tbody>
              <% view.snapshots.slice(0, 8).forEach((s) => { %>
                <tr>
                  <td class="small">
                    <a href="/clients/<%= c.id %>?snapshot=<%= s.id %>">
                      <%= formatDate(s.requested_at, { withTime: true }) %>
                    </a>
                    <% if (view.snapshot && s.id === view.snapshot.id) { %>
                      <span class="badge navy">viewing</span>
                    <% } %>
                  </td>
                  <td class="small">
                    <%= s.provider %>
                    <% if (s.is_simulated) { %><span class="badge simulated">sim</span><% } %>
                    <% if (s.status !== 'success') { %><span class="badge danger"><%= s.status %></span><% } %>
                  </td>
                  <td class="num small"><%= s.status === 'success' ? money(s.total_owed_cents, { compact: true }) : '—' %></td>
                  <td class="small muted"><%= s.requested_by_name || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ── Restructure proposal ─────────────────────────────────────────── -->
<% if (view.hasSnapshot && aff.hasIncomeData) { %>
  <div class="card section-anchor" id="restructure">
    <div class="card-head">
      <h2>Proposed restructure</h2>
      <span class="spacer"></span>
      <% if (r.feasible) { %>
        <span class="badge success">Workable on current figures</span>
      <% } else { %>
        <span class="badge danger">Not workable as it stands</span>
      <% } %>
    </div>
    <div class="card-body">
      <div class="grid grid-3" style="margin-bottom:1.25rem;">
        <div class="stat">
          <div class="stat-label">Paying now</div>
          <div class="stat-value"><%= money(r.currentInstalmentCents, { compact: true }) %></div>
          <div class="stat-note">per month across <%= d.accountCount %> accounts</div>
        </div>
        <div class="stat">
          <div class="stat-label">Proposed</div>
          <div class="stat-value success"><%= money(r.proposedInstalmentCents, { compact: true }) %></div>
          <div class="stat-note">per month, single distribution</div>
        </div>
        <div class="stat">
          <div class="stat-label"><%= r.monthlyReliefCents >= 0 ? 'Monthly relief' : 'Monthly increase' %></div>
          <div class="stat-value <%= r.monthlyReliefCents >= 0 ? 'success' : 'danger' %>">
            <%= money(Math.abs(r.monthlyReliefCents), { compact: true }) %>
          </div>
          <div class="stat-note">
            <% if (r.longestTermMonths) { %>
              plan runs <%= r.longestTermMonths %> months
            <% } else { %>
              term cannot be calculated
            <% } %>
          </div>
        </div>
      </div>

      <% if (r.warnings.length > 0) { %>
        <div class="notice notice-warn">
          <ul>
            <% r.warnings.forEach((w) => { %><li><%= w %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <% if (r.lines.length > 0) { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Creditor</th>
                <th>Treatment</th>
                <th class="num">Balance</th>
                <th class="num">Current</th>
                <th class="num">Proposed</th>
                <th class="num">Change</th>
                <th class="num">Term</th>
              </tr>
            </thead>
            <tbody>
              <% r.lines.forEach((line) => { %>
                <tr>
                  <td>
                    <strong><%= line.creditorName %></strong>
                    <br /><span class="muted small"><%= line.accountTypeLabel %></span>
                  </td>
                  <td>
                    <span class="badge <%= line.treatment === 'protected' ? 'navy' : '' %>">
                      <%= line.treatment === 'protected' ? 'asset protected' : 'restructured' %>
                    </span>
                  </td>
                  <td class="num"><%= money(line.balanceCents) %></td>
                  <td class="num muted"><%= money(line.currentInstalmentCents) %></td>
                  <td class="num"><strong><%= money(line.proposedInstalmentCents) %></strong></td>
                  <td class="num" style="color:<%= line.changeCents <= 0 ? 'var(--success)' : 'var(--danger)' %>">
                    <%= line.changeCents <= 0 ? '' : '+' %><%= money(line.changeCents) %>
                  </td>
                  <td class="num">
                    <% if (line.termMonths === null) { %>
                      <span class="badge danger">never settles</span>
                    <% } else { %>
                      <%= line.termMonths %> mo
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="2">Total</td>
                <td class="num"><%= money(r.totalBalanceCents) %></td>
                <td class="num"><%= money(r.currentInstalmentCents) %></td>
                <td class="num"><%= money(r.proposedInstalmentCents) %></td>
                <td class="num"></td>
                <td class="num"><%= r.longestTermMonths ? r.longestTermMonths + ' mo' : '—' %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% } %>

      <p class="footnote">
        This is a model, not an offer. It distributes the client's available income across creditors
        pro-rata to balance, at an assumed concession rate of <%= percent(r.concessionRateAnnual) %>, and keeps
        secured accounts at their contractual instalment where the income allows. The binding arrangement
        is whatever creditors accept or a magistrate orders under section 87 of the National Credit Act.
      </p>
    </div>
  </div>
<% } %>

<!-- ── Consent ──────────────────────────────────────────────────────── -->
<div class="card section-anchor" id="consent">
  <div class="card-head">
    <h2>Consent &amp; authority</h2>
    <span class="spacer"></span>
    <span class="badge <%= view.hasBureauConsent ? 'success' : 'danger' %>">
      <%= view.hasBureauConsent ? 'Bureau consent active' : 'No bureau consent' %>
    </span>
  </div>
  <div class="card-body">
    <% if (view.consents.length > 0) { %>
      <div class="table-wrap" style="margin-bottom:1.25rem;">
        <table>
          <thead>
            <tr><th>Type</th><th>Granted</th><th>Expires</th><th>Method</th><th>Evidence</th><th>Captured by</th><th></th></tr>
          </thead>
          <tbody>
            <% view.consents.forEach((con) => { %>
              <tr>
                <td><%= con.consent_type.replace(/_/g, ' ') %></td>
                <td class="small"><%= formatDate(con.granted_at) %></td>
                <td class="small"><%= con.expires_at ? formatDate(con.expires_at) : 'no expiry' %></td>
                <td class="small"><%= consentMethods[con.method] || con.method %></td>
                <td class="small muted"><%= con.evidence_ref || '—' %></td>
                <td class="small muted"><%= con.captured_by_name || '—' %></td>
                <td>
                  <% if (con.revoked_at) { %>
                    <span class="badge danger">revoked <%= formatDate(con.revoked_at) %></span>
                  <% } else if (canEdit) { %>
                    <form method="post" action="/clients/<%= c.id %>/consent/<%= con.id %>/revoke">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-sm btn-danger">Revoke</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="muted" style="margin-bottom:1.1rem;">No consent has been captured for this client yet.</p>
    <% } %>

    <% if (canEdit) { %>
      <details <%= view.hasBureauConsent ? '' : 'open' %>>
        <summary style="cursor:pointer;font-weight:600;color:var(--navy);">Record consent</summary>
        <form method="post" action="/clients/<%= c.id %>/consent" style="margin-top:0.9rem;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="field-row">
            <div class="field">
              <label for="consentType">Consent for</label>
              <select id="consentType" name="consentType">
                <option value="bureau_enquiry">Credit bureau enquiry</option>
                <option value="data_processing">Processing personal information</option>
                <option value="marketing">Marketing communication</option>
              </select>
            </div>
            <div class="field">
              <label for="method">How it was given</label>
              <select id="method" name="method" required>
                <% Object.entries(consentMethods).forEach(([key, label]) => { %>
                  <option value="<%= key %>"><%= label %></option>
                <% }) %>
              </select>
            </div>
            <div class="field">
              <label for="expiresAt">Expires (optional)</label>
              <input type="date" id="expiresAt" name="expiresAt" />
            </div>
            <div class="field">
              <label for="evidenceRef">Where the signed mandate is filed</label>
              <input type="text" id="evidenceRef" name="evidenceRef" placeholder="e.g. Mandate folder / 2026 / MFG-2026-0042" />
            </div>
          </div>
          <button type="submit" class="btn btn-gold">Record consent</button>
          <p class="footnote">
            Only record consent you actually hold. Running a bureau enquiry without the client's
            consent breaches both the National Credit Act and POPIA, and this record is what the
            practice would rely on if that were ever questioned.
          </p>
        </form>
      </details>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
