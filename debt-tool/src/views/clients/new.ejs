<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <h1>Add a client</h1>
    <p class="sub">The ID number is checked before it is saved, so a mistyped digit is caught here rather than by a wasted bureau enquiry.</p>
  </div>
</div>

<div class="card" style="max-width:760px;">
  <div class="card-body">
    <% if (error) { %><div class="notice notice-error"><%= error %></div><% } %>

    <form method="post" action="/clients">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="field-row">
        <div class="field">
          <label for="firstName">First name</label>
          <input type="text" id="firstName" name="firstName" required autofocus value="<%= values.firstName || '' %>" />
        </div>
        <div class="field">
          <label for="lastName">Surname</label>
          <input type="text" id="lastName" name="lastName" required value="<%= values.lastName || '' %>" />
        </div>
      </div>

      <div class="field">
        <label for="idNumber">South African ID number</label>
        <input type="text" id="idNumber" name="idNumber" required inputmode="numeric" maxlength="16"
               value="<%= values.idNumber || '' %>" placeholder="13 digits" />
        <p class="hint">Stored encrypted. Only the last four digits are shown anywhere in the tool.</p>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="phone">Phone</label>
          <input type="text" id="phone" name="phone" value="<%= values.phone || '' %>" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= values.email || '' %>" />
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="employmentStatus">Employment</label>
          <select id="employmentStatus" name="employmentStatus">
            <option value="">Not stated</option>
            <option value="permanent">Permanently employed</option>
            <option value="contract">Contract</option>
            <option value="self_employed">Self-employed</option>
            <option value="pensioner">Pensioner</option>
            <option value="unemployed">Unemployed</option>
          </select>
        </div>
        <div class="field">
          <label for="maritalStatus">Marital status</label>
          <select id="maritalStatus" name="maritalStatus">
            <option value="">Not stated</option>
            <option value="single">Single</option>
            <option value="married_cop">Married in community of property</option>
            <option value="married_anc">Married out of community of property</option>
            <option value="divorced">Divorced</option>
            <option value="widowed">Widowed</option>
          </select>
        </div>
        <div class="field">
          <label for="dependants">Dependants</label>
          <input type="number" id="dependants" name="dependants" min="0" max="20" value="<%= values.dependants || 0 %>" />
        </div>
      </div>

      <div class="field">
        <label for="notes">File notes</label>
        <textarea id="notes" name="notes"><%= values.notes || '' %></textarea>
      </div>

      <div class="btn-row">
        <button type="submit" class="btn btn-gold">Create client file</button>
        <a href="/clients" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
