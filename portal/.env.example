# MFG Portal — environment variables. Copy to .env.local for local work.
# Put real values in Vercel → Project → Settings → Environment Variables. Never commit them.

# --- Supabase (Dashboard → Project Settings → API) ---
# Project URL. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (public) key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key. SERVER ONLY: bypasses RLS. Used only to set the owner flag, send invites and delete accounts.
SUPABASE_SECRET_KEY=

# --- Roles ---
# Comma-separated owner emails (§3). Anyone signing in with a verified one of these becomes the owner.
OWNER_EMAILS=

# --- App ---
# Public address of the portal, used in email links and OAuth redirects.
NEXT_PUBLIC_SITE_URL=https://portal.mlinjanafinancialgroup.com

# --- Sign-in providers: "true" shows the button (§4). Each also needs setting up in Supabase → Authentication → Providers. ---
NEXT_PUBLIC_AUTH_GOOGLE=true
NEXT_PUBLIC_AUTH_APPLE=false
NEXT_PUBLIC_AUTH_FACEBOOK=false
NEXT_PUBLIC_AUTH_LINKEDIN=false

# --- Transactional email (provider to be confirmed with Chuma) ---
# API key for the email provider. Server only.
EMAIL_API_KEY=
# Sender address on the verified domain, e.g. "MFG Portal <portal@mlinjanafinancialgroup.com>".
EMAIL_FROM=

# --- Scheduled jobs ---
# Random secret that Vercel Cron sends so only it can trigger the payday reminder job.
CRON_SECRET=

# --- Security ---
# Minutes of inactivity before coaches and the owner are signed out (§11.2).
STAFF_IDLE_TIMEOUT_MINUTES=30
